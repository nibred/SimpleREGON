<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.0.1</Version>
    <SignAssembly>True</SignAssembly>
    <Authors>Oleksii Derbin</Authors>
    <Company />
    <RepositoryUrl>https://github.com/nibred/SimpleREGON</RepositoryUrl>
    <PackageProjectUrl>https://github.com/nibred/SimpleREGON</PackageProjectUrl>
    <PackageTags>REGON; NIP; KRS; GUS</PackageTags>
    <Title>SimpleREGON umożliwia pobieranie danych firm w formacie JSON na podstawie numerów NIP, REGON lub KRS z wyszukiwarki REGON, bez konieczności używania klucza API</Title>
    <Description>SimpleREGON to biblioteka .NET umożliwiająca pobieranie danych firm po numerach NIP, REGON lub KRS z wyszukiwarki REGON bez konieczności używania klucza API. Dane zwracane są w formacie JSON</Description>
    <AssemblyOriginatorKeyFile>SimpleREGON.snk</AssemblyOriginatorKeyFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageReadmeFile>SimpleREGON.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\SimpleREGON.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
